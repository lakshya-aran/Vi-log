rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins can see everyone's profiles and time entries.
    // To add or remove an admin, edit this list and publish the rules again.
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'lakshya1244612446@gmail.com'
      ];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Name and email, so admins can see who each entry belongs to
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email'])
        && request.resource.data.email == request.auth.token.email
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100));
    }

    // Each employee can only read and write their own time entries
    match /users/{uid}/entries/{entryId} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['project', 'notes', 'startedAt', 'endedAt', 'createdAt'])
        && request.resource.data.project is string && request.resource.data.project.size() <= 200
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 5000
        && request.resource.data.startedAt is timestamp;
    }

    // Lets admins load all entries in one query (team view)
    match /{path=**}/entries/{entryId} {
      allow read: if isAdmin();
    }
  }
}
